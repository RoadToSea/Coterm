{
  "manifestVersion": 1,
  "id": "coterm-driver-ssh",
  "name": "SSH",
  "version": "0.1.0",
  "runtime": {
    "interfaceMajor": 2,
    "requires": [
      "instances",
      "backend-calls",
      "operation-catalog",
      "secret-delivery",
      "native-mcp-tools",
      "deferred-interactions",
      "async-operations",
      "driver-events"
    ]
  },
  "mcp": {
    "provider": "backend"
  },
  "instances": {
    "type": "ssh-connection",
    "multiple": true
  },
  "capabilities": [
    "secret-input",
    "confirmation"
  ],
  "ui": {
    "workbench": "terminal",
    "title": "Open SSH",
    "schema": {
      "type": "object",
      "required": [
        "host",
        "port",
        "username"
      ],
      "properties": {
        "host": {
          "type": "string",
          "title": "Host",
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "title": "Port",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "title": "Username",
          "maxLength": 128
        }
      }
    },
    "defaults": {
      "host": "",
      "port": 22,
      "username": ""
    }
  }
}
