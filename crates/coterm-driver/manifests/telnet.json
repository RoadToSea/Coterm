{
  "manifestVersion": 1,
  "id": "coterm-driver-telnet",
  "name": "Telnet",
  "version": "0.1.0",
  "runtime": {
    "interfaceMajor": 2,
    "requires": [
      "instances",
      "backend-calls",
      "operation-catalog",
      "native-mcp-tools",
      "async-operations",
      "driver-events"
    ]
  },
  "mcp": {
    "provider": "backend"
  },
  "instances": {
    "type": "telnet-terminal",
    "multiple": true
  },
  "capabilities": [
    "confirmation"
  ],
  "ui": {
    "workbench": "terminal",
    "title": "Create instance",
    "schema": {
      "type": "object",
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "type": "string",
          "title": "Remote host",
          "maxLength": 253,
          "x-help": "Telnet is unencrypted. Enter passwords only in the terminal."
        },
        "port": {
          "type": "integer",
          "title": "Port",
          "minimum": 1,
          "maximum": 65535
        },
        "connectTimeoutMs": {
          "type": "integer",
          "title": "Connection timeout (ms)",
          "minimum": 100,
          "maximum": 60000
        },
        "autoReconnect": {
          "type": "boolean",
          "title": "Reconnect after disconnection",
          "x-help": "Reconnecting never replays input."
        },
        "reconnectIntervalMs": {
          "type": "integer",
          "title": "Reconnect interval (ms)",
          "minimum": 250,
          "maximum": 60000,
          "x-enabledBy": "autoReconnect"
        },
        "proxy": {
          "type": "object",
          "title": "Proxy",
          "properties": {
            "type": {
              "type": "string",
              "title": "Proxy",
              "enum": [
                "direct",
                "socks5",
                "http"
              ],
              "x-enumNames": [
                "Direct",
                "SOCKS5 (no authentication)",
                "HTTP CONNECT (no authentication)"
              ]
            },
            "host": {
              "type": "string",
              "title": "Proxy host",
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "title": "Proxy port",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "localEcho": {
          "type": "string",
          "title": "Local echo",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "x-enumNames": [
            "Automatic",
            "On",
            "Off"
          ]
        },
        "receiveNewlines": {
          "type": "string",
          "title": "Receive newline completion",
          "enum": [
            "none",
            "lf",
            "cr",
            "both"
          ],
          "x-enumNames": [
            "None",
            "Complete LF with CR",
            "Complete CR with LF",
            "Complete CR and LF"
          ]
        },
        "backspace": {
          "type": "string",
          "title": "Backspace key",
          "enum": [
            "bs",
            "del"
          ],
          "x-enumNames": [
            "BS (0x08)",
            "DEL (0x7F)"
          ]
        },
        "username": {
          "type": "string",
          "title": "Login username (optional)",
          "maxLength": 128,
          "x-help": "Telnet is unencrypted. Enter passwords only in the terminal."
        },
        "terminalType": {
          "type": "string",
          "title": "Terminal type",
          "enum": [
            "xterm",
            "xterm-256color",
            "vt100"
          ]
        },
        "prompt": {
          "type": "string",
          "title": "Shell prompt",
          "maxLength": 256,
          "x-help": "Use the complete visible Shell prompt; trailing spaces are ignored. Shell reads require terminal mode."
        }
      }
    },
    "defaults": {
      "host": "",
      "port": 23,
      "username": null,
      "connectTimeoutMs": 5000,
      "autoReconnect": false,
      "reconnectIntervalMs": 1000,
      "proxy": {
        "type": "direct"
      },
      "localEcho": "auto",
      "receiveNewlines": "none",
      "backspace": "del",
      "terminalType": "xterm",
      "mode": "shell",
      "prompt": "# "
    }
  }
}
