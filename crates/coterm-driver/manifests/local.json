{
  "manifestVersion": 1,
  "id": "coterm-driver-local",
  "name": "Local",
  "version": "0.1.0",
  "runtime": {
    "interfaceMajor": 2,
    "requires": [
      "instances",
      "backend-calls",
      "operation-catalog",
      "driver-events",
      "async-operations",
      "native-mcp-tools"
    ]
  },
  "mcp": {
    "provider": "backend"
  },
  "instances": {
    "type": "local-shell",
    "multiple": true
  },
  "capabilities": [
    "confirmation"
  ],
  "ui": {
    "workbench": "terminal",
    "title": "Open terminal",
    "schema": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "string",
          "title": "Shell",
          "x-help": "Leave empty to detect the system shell."
        },
        "cwd": {
          "type": "string",
          "title": "Working directory",
          "x-help": "Leave empty to start in your home directory."
        }
      }
    },
    "defaults": {
      "shell": "",
      "cwd": ""
    }
  }
}
