{
  "manifestVersion": 1,
  "id": "coterm-plugin-local",
  "name": "Local",
  "version": "0.1.0",
  "runtime": {
    "interfaceMajor": 1,
    "requires": ["instances", "backend-calls", "operation-catalog", "plugin-events"]
  },
  "backend": {
    "windows-x64": "backend/coterm-plugin-local.exe",
    "windows-arm64": "backend/coterm-plugin-local.exe",
    "linux-x64": "backend/coterm-plugin-local",
    "linux-arm64": "backend/coterm-plugin-local",
    "macos-x64": "backend/coterm-plugin-local",
    "macos-arm64": "backend/coterm-plugin-local"
  },
  "mcp": { "provider": "backend" },
  "instances": { "type": "local-shell", "multiple": true },
  "capabilities": []
}
