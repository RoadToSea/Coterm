{
  "manifestVersion": 1,
  "id": "coterm-plugin-serial",
  "name": "Serial",
  "version": "0.1.0",
  "runtime": {
    "interfaceMajor": 1,
    "requires": ["instances", "backend-calls", "operation-catalog", "native-mcp-tools", "async-operations", "plugin-events"]
  },
  "backend": {
    "windows-x64": "backend/coterm-plugin-serial.exe",
    "windows-arm64": "backend/coterm-plugin-serial.exe",
    "linux-x64": "backend/coterm-plugin-serial",
    "linux-arm64": "backend/coterm-plugin-serial",
    "macos-x64": "backend/coterm-plugin-serial",
    "macos-arm64": "backend/coterm-plugin-serial"
  },
  "frontend": { "entry": "frontend/index.js" },
  "mcp": { "provider": "backend" },
  "instances": { "type": "serial-port", "multiple": true },
  "capabilities": ["confirmation"]
}
