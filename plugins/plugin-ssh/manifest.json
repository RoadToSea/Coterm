{
  "manifestVersion": 1,
  "id": "coterm-plugin-ssh",
  "name": "SSH",
  "version": "0.1.0",
  "runtime": {
    "interfaceMajor": 1,
    "requires": ["instances", "backend-calls", "operation-catalog", "secret-delivery", "native-mcp-tools", "deferred-interactions", "async-operations", "plugin-events"]
  },
  "backend": {
    "windows-x64": "backend/coterm-plugin-ssh.exe",
    "windows-arm64": "backend/coterm-plugin-ssh.exe",
    "linux-x64": "backend/coterm-plugin-ssh",
    "linux-arm64": "backend/coterm-plugin-ssh",
    "macos-x64": "backend/coterm-plugin-ssh",
    "macos-arm64": "backend/coterm-plugin-ssh"
  },
  "frontend": { "entry": "frontend/index.js" },
  "mcp": { "provider": "backend" },
  "instances": { "type": "ssh-connection", "multiple": true },
  "capabilities": ["secret-input", "confirmation"]
}
