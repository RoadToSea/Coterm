{
  "name": "coterm-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "description": "The Collaborative Terminal for Humans and AI Agents",
  "imports": {
    "#support/*": "./tests/support/*",
    "#fixtures/*": "./tests/fixtures/*",
    "#shared/*": "./apps/shared/*",
    "#desktop/*": "./apps/desktop/*",
    "#driver/*": "./crates/coterm-driver/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "test": "node scripts/test-runner.mjs",
    "test:all": "node scripts/test-runner.mjs all",
    "test:unit": "node scripts/test-runner.mjs unit",
    "test:browser": "node scripts/test-runner.mjs browser",
    "test:serial": "node scripts/test-runner.mjs serial",
    "test:ssh": "node scripts/test-runner.mjs ssh",
    "test:desktop": "node scripts/test-runner.mjs desktop",
    "test:workspace": "node scripts/test-runner.mjs workspace",
    "test:approval": "node scripts/test-runner.mjs approval",
    "test:shared": "node scripts/test-runner.mjs shared",
    "test:build": "node scripts/build-shared-browser.mjs && node scripts/build-host-interactions-entry.mjs && node scripts/build-workbench-tests.mjs",
    "test:native": "node scripts/test-native.mjs",
    "debug:clean": "node scripts/clean-agent-debug.mjs",
    "dev": "pnpm --filter coterm-desktop dev",
    "build": "pnpm --filter coterm-desktop build",
    "tauri": "pnpm --filter coterm-desktop tauri",
    "tauri:dev": "pnpm --filter coterm-desktop tauri dev",
    "tauri:build": "node scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
