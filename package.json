{
  "name": "coterm-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "description": "The Collaborative Terminal for Humans and AI Agents",
  "scripts": {
    "test": "pnpm test:build && node --import ./scripts/test-ts-loader.mjs --test tests/*.test.mjs",
    "test:build": "node scripts/build-sdk-browser.mjs && node scripts/build-host-interactions-entry.mjs",
    "test:native": "node scripts/test-native.mjs",
    "plugin:ssh:build": "node scripts/build-ssh.mjs",
    "plugin:serial:build": "node scripts/build-serial.mjs",
    "dev": "pnpm --filter coterm-desktop dev",
    "build": "pnpm --filter coterm-desktop build",
    "tauri": "pnpm --filter coterm-desktop tauri",
    "tauri:dev": "pnpm --filter coterm-desktop tauri dev",
    "tauri:build": "node scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
